DATABASE_URL=sqlite://roya.db
ALLOW_NEGATIVE_BALANCE=false
ALLOW_NEGATIVE_STOCK=true
ENFORCE_CREDIT_LIMIT=true
RUST_LOG=info

# Identity (S1). The bootstrap administrator's password: unset means a password
# is generated and logged once at startup (the operator must read the log).
#ROYA_ADMIN_PASSWORD=

# Absolute session lifetime in hours (cookie Max-Age and session row expiry).
#ROYA_SESSION_TTL_HOURS=12

# REQUIRED when the app is served over HTTPS: true marks the session cookie
# Secure. Without it the cookie is not marked Secure and can travel over HTTP.
#ROYA_COOKIE_SECURE=false

# Comma-separated CORS origins; unset means same-origin only (no wildcard).
#ROYA_ALLOWED_ORIGINS=

# Failed logins per username before the throttle kicks in, and its window.
#ROYA_LOGIN_THROTTLE_ATTEMPTS=5
#ROYA_LOGIN_THROTTLE_SECONDS=60
